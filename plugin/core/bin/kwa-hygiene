#!/usr/bin/env python3
"""kwa-hygiene — contrôle d'hygiène de remise : ce qui ne doit pas partir chez le client.

    kwa-hygiene [--strict] [--root DIR]

Périmètre : les fichiers « produit » (code, config, scripts, .github, outillage .claude/ qui a valeur
d'instruction) ; hors tests et fixtures, hors docs/, hors le pack Kwa lui-même.
Par gravité :
  SECRET      une valeur d'identifiant en dur                       bloquant
  PERSONNEL   un compte personnel ou prestataire câblé au produit   bloquant
  NOMINATIF   une personne nommée là où un rôle vieillirait mieux   avertissement
  PÉRISSABLE  une mesure datée dans un fichier d'INSTRUCTION        avertissement
Exceptions : .claude/kwa.hygiene.allow (réaffichées à chaque exécution : c'est la checklist de remise).
Politique (.claude/kwa.policy.json → hygiene) : personal_domains, names, stale_patterns, stale_in, include, exclude.
--strict : les avertissements deviennent bloquants. Codes : 0 ok, 1 bloquant.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys

INCLUDE = r"^(apps/|packages/|src/|scripts/|\.claude/|\.github/|\.env\.example|[^/]+\.(json|yml|yaml|ts|js|mjs)$)"
EXCLUDE = (r"(__tests__/|\.spec\.|\.test\.|e2e-spec|/dist/|\.d\.ts$|^docs/|^\.claude/kwa/|^\.claude/kwa\.|"
           r"^\.github/(workflows/kwa-hygiene|ISSUE_TEMPLATE/|pull_request_template)|^\.claude/rules/kwa-)")
SECRET = (r"(password|passwd|secret|token|api_?key|apikey)[ \t]*[:=][ \t]*[\"'][A-Za-z0-9+/_=.-]{20,}[\"']")
SECRET_OK = r"(process\.env|<[A-Za-z_]|changeme|xxx|votre|your|example|placeholder|\$\{)"
STALE = r"[0-9]{3,} (utilisateurs|sociétés|dossiers|clients|deals|contacts)|[0-9]+ migrations"


def load_allow(path: str) -> list[tuple[str, str, str]]:
    out = []
    try:
        for line in open(path, encoding="utf-8"):
            if line.strip() and not line.lstrip().startswith("#"):
                parts = re.split(r"\s+", line.strip(), maxsplit=2)
                if len(parts) >= 2:
                    out.append((parts[0], parts[1], parts[2] if len(parts) > 2 else ""))
    except OSError:
        pass
    return out


def mask(line: str) -> str:
    return re.sub(r"([a-zA-Z0-9._%+-]{3})[a-zA-Z0-9._%+-]*@", r"\1***@", line)


def main(argv: list[str]) -> int:
    strict = "--strict" in argv
    root = argv[argv.index("--root") + 1] if "--root" in argv else "."
    root = os.path.abspath(root)
    try:
        pol = json.load(open(os.path.join(root, ".claude", "kwa.policy.json"), encoding="utf-8")).get("hygiene", {})
    except (OSError, ValueError):
        pol = {}
    allow = load_allow(os.path.join(root, ".claude", "kwa.hygiene.allow"))
    files = subprocess.run(["git", "-C", root, "ls-files"], capture_output=True, text=True).stdout.split("\n")
    inc, exc = re.compile(pol.get("include", INCLUDE)), re.compile(pol.get("exclude", EXCLUDE))
    product = [f for f in files if f and inc.search(f) and not exc.search(f)]
    domains = pol.get("personal_domains", ["gmail", "googlemail", "outlook", "hotmail", "yahoo", "icloud", "proton"])
    names = pol.get("names", [])
    families = [
        ("SECRET", "identifiant en dur", re.compile(SECRET, re.I), re.compile(SECRET_OK, re.I), None),
        ("PERSONNEL", "compte personnel ou prestataire",
         re.compile(r"[a-zA-Z0-9._%+-]+@(" + "|".join(map(re.escape, domains)) + r")[a-zA-Z0-9.-]*") if domains else None,
         re.compile(r"@(demo|example)\."), None),
        ("NOMINATIF", "personne nommée (préférer un rôle)",
         re.compile("(" + "|".join(map(re.escape, names)) + ")") if names else None, None, None),
        ("PÉRISSABLE", "mesure datée dans une instruction", re.compile(pol.get("stale_patterns", STALE)), None,
         re.compile("^(" + "|".join(map(re.escape, pol.get("stale_in", [".claude/"]))) + ")")),
    ]
    blocking = warning = deferred = 0
    print("Hygiène de remise — périmètre produit (hors tests, hors docs/)\n")
    for fam, title, rx, ok, scope in families:
        hits, skipped = [], 0
        if rx:
            for f in product:
                if scope and not scope.search(f):
                    continue
                try:
                    text = open(os.path.join(root, f), encoding="utf-8", errors="ignore").read()
                except OSError:
                    continue
                for n, line in enumerate(text.splitlines(), 1):
                    if rx.search(line) and not (ok and ok.search(line)):
                        if any(a[0] == fam and a[1] == f for a in allow):
                            skipped += 1
                        else:
                            hits.append(f"{f}:{n}:{mask(line.strip())[:140]}")
        deferred += skipped
        suffix = f" (+{skipped} reporté(s))" if skipped else ""
        print(f"  {fam:11} {title:40} {len(hits) or 'aucun'}{suffix}")
        for h in hits:
            print(f"      {h}")
        if fam in ("SECRET", "PERSONNEL"):
            blocking += len(hits)
        else:
            warning += len(hits)
    if deferred:
        print(f"\nExceptions assumées — {deferred} occurrence(s) écartée(s), cf. .claude/kwa.hygiene.allow :")
        for fam, path, why in allow:
            print(f"      {fam} {path} {why}".rstrip())
    print()
    if blocking:
        print(f"BLOQUANT : {blocking} occurrence(s) à traiter.")
        return 1
    if warning:
        print(f"{warning} avertissement(s) — dette, pas fuite. Non bloquant.")
        if strict:
            print("--strict : traité comme un échec.")
            return 1
        return 0
    print("Rien à signaler dans le périmètre produit.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
