#!/usr/bin/env python3
"""kwa-memory — capture et tri des apprentissages de session (module memory).

    kwa-memory capture <gotcha|decision|rule|pref|vault> "<texte>"   note rapide, pendant la session
    kwa-memory pending                                                notes en attente
    kwa-memory digest                                                 tout ce qu'il faut pour /kwa-learn
    kwa-memory clear                                                  archive les notes traitées
    kwa-memory journal "<texte>"                                      entrée de journal de la session (8 lignes au plus)
    kwa-memory journal --last [N] | --list | --prune [jours]          relire, lister, purger le journal

Notes, journal et signaux vivent dans .claude/kwa/local/ du dépôt principal (non versionné : exclu via
.git/info/exclude par `kwa install` ; un worktree qui disparaît n'emporte rien). KWA_JOURNAL=0 coupe le journal.
Rien n'est écrit dans la documentation d'ici : c'est /kwa-learn qui propose, et l'utilisateur qui valide.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time

KINDS = {"gotcha", "decision", "rule", "pref", "vault"}

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
import _journal  # noqa: E402  (installé avec ce script, dans .claude/kwa/hooks)


def root() -> str:
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else os.getcwd()


def local(r: str) -> str:
    return _journal.local_dir(r)


def policy(r: str) -> dict:
    try:
        with open(os.path.join(r, ".claude", "kwa.policy.json"), encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def inbox_lines(r: str) -> list[str]:
    try:
        return [x.rstrip() for x in open(os.path.join(local(r), "inbox.md"), encoding="utf-8") if x.strip()]
    except OSError:
        return []


def git(r: str, *args: str) -> str:
    return subprocess.run(["git", "-C", r, *args], capture_output=True, text=True).stdout.strip()


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    r, cmd = root(), argv[0]
    if cmd == "capture":
        if len(argv) < 3 or argv[1] not in KINDS:
            print(f"usage : kwa-memory capture <{'|'.join(sorted(KINDS))}> \"<texte>\"", file=sys.stderr)
            return 2
        with open(os.path.join(local(r), "inbox.md"), "a", encoding="utf-8") as f:
            f.write(f"- [{time.strftime('%Y-%m-%d')}] [{argv[1]}] {' '.join(argv[2:])}\n")
        print("noté.")
        return 0
    if cmd == "pending":
        lines = inbox_lines(r)
        print(f"{len(lines)} note(s) en attente" + ("\n" + "\n".join(lines) if lines else ""))
        return 0
    if cmd == "clear":
        src = os.path.join(local(r), "inbox.md")
        if os.path.exists(src):
            arch = os.path.join(local(r), "archive")
            os.makedirs(arch, exist_ok=True)
            os.replace(src, os.path.join(arch, f"{time.strftime('%Y%m%d-%H%M%S')}.md"))
        print("notes archivées.")
        return 0
    if cmd == "journal":
        pol, rest = policy(r), argv[1:]
        if not _journal.enabled():
            print("journal désactivé (KWA_JOURNAL=0).")
            return 0
        jdir = _journal.journal_dir(r, pol)
        if rest[:1] == ["--last"]:
            n = int(rest[1]) if len(rest) > 1 and rest[1].isdigit() else 3
            entries = _journal.read_entries(jdir, n)
            print("\n\n".join(open(e["path"], encoding="utf-8").read().strip() for e in entries) if entries else "(aucune entrée)")
            return 0
        if rest[:1] == ["--list"]:
            for e in _journal.read_entries(jdir):
                print(f"{e.get('date', '?')} · {e.get('branch', '?')} · {_journal._first(e)}")
            return 0
        if rest[:1] == ["--prune"]:
            days = int(rest[1]) if len(rest) > 1 and rest[1].isdigit() else _journal.journal_days(pol)
            print(f"{_journal.prune(jdir, days)} entrée(s) de plus de {days} jours supprimée(s).")
            return 0
        text = " ".join(rest) or ("" if sys.stdin.isatty() else sys.stdin.read())
        body, err = _journal.validate_body(text)
        if err:
            print(f"journal : {err}", file=sys.stderr)
            return 2
        sess = _journal.current_session(r) or _journal.start_session(r, {"session_id": f"manuel-{int(time.time())}"})
        _journal.write_entry(r, sess, pol, body=body)
        print(f"journal noté (session {sess['id'][:8]}).")
        return 0
    if cmd == "digest":
        try:
            pol = json.load(open(os.path.join(r, ".claude", "kwa.policy.json"), encoding="utf-8")).get("memory", {})
        except (OSError, ValueError):
            pol = {}
        base = (json.load(open(os.path.join(r, ".claude", "kwa.policy.json"))).get("base_branch", "main")
                if os.path.exists(os.path.join(r, ".claude", "kwa.policy.json")) else "main")
        print("## Notes en attente\n" + ("\n".join(inbox_lines(r)) or "(aucune)"))
        if _journal.enabled():
            entries = _journal.read_entries(_journal.journal_dir(r, policy(r)), 3)
            print("\n## Journal des dernières sessions\n" + ("\n\n".join(open(e["path"], encoding="utf-8").read().strip() for e in entries) or "(aucune entrée)"))
            sig = _journal.read_signals(r, 30)
            refus: dict[str, int] = {}
            for x in sig:
                if x.get("kind") == "refus":
                    refus[x.get("key", "?")] = refus.get(x.get("key", "?"), 0) + 1
            print("\n## Signaux des 30 derniers jours")
            print("\n".join(f"- refus x{n} : {k}" + ("  <- répété : consigne ou règle manquante ?" if n >= 3 else "") for k, n in sorted(refus.items(), key=lambda kv: -kv[1])) or "(aucun refus de garde)")
            corr = [x for x in sig if x.get("kind") in ("correction", "marqueur")]
            print(f"- {len(corr)} correction(s) ou marqueur(s) « retiens : » (déjà dans les notes en attente)")
        print(f"\n## Branche : {git(r, 'symbolic-ref', '--short', '-q', 'HEAD') or '(détachée)'}")
        print("## Commits depuis la base\n" + (git(r, "log", "--oneline", f"origin/{base}..HEAD") or "(aucun)"))
        print("## Fichiers modifiés (non commités)\n" + (git(r, "status", "--porcelain", "-uall") or "(aucun)"))
        print("## Fichiers modifiés (commités sur la branche)\n" + (git(r, "diff", "--stat", f"origin/{base}...HEAD") or "(aucun)"))
        print("\n## Destinations")
        print(f"- décisions : {pol.get('decisions_dir', 'docs/decisions')}")
        print(f"- pièges : {pol.get('gotchas_file', 'docs/gotchas.md')}")
        print("- règles / garde-fous : .claude/kwa.policy.json")
        vault = os.environ.get("KWA_VAULT_INBOX", "")
        print(f"- base de connaissance de l'équipe (capture seulement) : {vault or '(KWA_VAULT_INBOX non défini → ne pas écrire dans la base de connaissance)'}")
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
