    "stack-prisma": {
      "about": "Migrations append-only, pas de reset / db push",
      "detect": {
        "dir_glob": [
          "**/prisma/migrations"
        ]
      },
      "policy": {
        "write": {
          "deny": [
            {
              "id": "prisma-migrations",
              "glob": "**/prisma/migrations/**",
              "reason": "Migrations append-only : celles-ci sont peut-être déjà appliquées en recette ou en prod. Réécrire un fichier appliqué désynchronise _prisma_migrations. Créer une nouvelle migration."
            }
          ]
        },
        "bash": {
          "deny": [
            {
              "id": "prisma-reset",
              "reason": "reset / db push réécrivent l'historique des migrations : interdit. Créer une nouvelle migration.",
              "any": [
                "prisma migrate reset",
                "--force-reset",
                "prisma db push"
              ]
            }
          ]
        }
      }
    },
    "stack-expo": {
      "about": "/kwa-testflight (Release sur simulateur avant build EAS), soumission EAS soumise à confirmation",
      "detect": {
        "files": [
          "**/eas.json"
        ]
      },
      "files": {
        "core/skills/testflight/*": {
          "dest": ".claude/skills/kwa-testflight"
        }
      },
      "policy": {
        "bash": {
          "ask": [
            {
              "id": "eas-submit",
              "reason": "Soumission TestFlight / store (visible par le client). Le build a-t-il été validé en Release sur simulateur ? Voir /kwa-testflight.",
              "any": [
                "eas submit",
                "eas-cli submit"
              ]
            }
          ]
        }
      }
    },
    "stack-scaleway": {
      "about": "Déploiement Scaleway en direct soumis à confirmation",
      "detect": {
        "text_in": {
          "glob": ".github/workflows/*.yml",
          "any": [
            "scw ",
            "scaleway",
            "SCW_"
          ]
        }
      },
      "policy": {
        "bash": {
          "ask": [
            {
              "id": "scw-direct",
              "reason": "Déploiement Scaleway en direct = contournement du pipeline CI. Rappel : un update d'env REMPLACE toute la map, et un update redéploie (jobs en cours tués).",
              "any": [
                "scw container container (update|deploy)"
              ]
            }
          ]
        }
      }
